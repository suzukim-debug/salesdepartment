# ─── Anthropic Claude API ───────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxx

# ─── Gmail API (推奨) ────────────────────────────────────────
# Google Cloud Console で OAuth2クライアントID を作成しダウンロード
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
GMAIL_SENDER_EMAIL=your-email@gmail.com
GMAIL_FROM_NAME=株式会社XXX 営業部

# ─── SMTPフォールバック (Gmail未設定時) ─────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=株式会社XXX 営業部

# ─── Google Sheets ────────────────────────────────────────────
# スプレッドシートのURL末尾のID（/d/XXXX/editのXXXX部分）
SHEETS_SPREADSHEET_ID=
# 認証はGmailと同じtoken.jsonを使用（またはservice_account.json）
SHEETS_HOT_LEADS_TAB=ホットリード
SHEETS_CALL_LOG_TAB=架電ログ
SHEETS_RESULTS_TAB=分析

# ─── アプリ設定 ───────────────────────────────────────────────
BASE_URL=https://your-domain.com
DATABASE_URL=sqlite:///./salesdepartment.db

# ─── スクレイピング ──────────────────────────────────────────
SCRAPE_DELAY_SECONDS=2.0
SCRAPE_TIMEOUT_SECONDS=15
SCRAPE_USE_PLAYWRIGHT=false

# ─── スケジューラ ────────────────────────────────────────────
FOLLOW_UP_DAYS=7
GMAIL_CHECK_INTERVAL_MINUTES=15
